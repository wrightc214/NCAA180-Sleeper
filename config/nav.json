{
  "_doc": [
    "The site menu (todo-header-rebuild.md). Edit here, then run: python scripts/menu_build.py",
    "That writes reports/assets/menu.js, which every page loads; no page needs rebuilding for a menu change.",
    "state: visible (everyone) | hidden-dev (shown only with Dev view on; listed in the public menu.js) | hidden (left out of menu.js; direct link only).",
    "Neither hidden state is secret: the repo and every built page are public.",
    "aliases: other page keys (data-current) that highlight this tab. href '@awards' = the latest week's awards page.",
    "rows: fixed sub-rows (a page asks for one with data-row). Data-driven rows (seasons, weeks, projection archive) are built from the pages in reports/."
  ],
  "tabs": [
    {"id": "awards", "label": "Awards", "href": "@awards"},
    {"id": "map", "label": "Roster Map", "href": "roster-map.html"},
    {"id": "standings", "label": "Standings", "href": "standings.html"},
    {"id": "scoreboard", "label": "Games", "href": "scoreboard.html"},
    {"id": "poll", "label": "Poll", "href": "poll.html", "aliases": ["poll-how", "poll-bots"]},
    {"id": "postseason", "label": "Postseason", "href": "postseason.html"},
    {"_note": "Selection Watch tab public since 2026-11-20 (Chris) for the CCG sub-page; Playoffs stays Dev-only via its sub-row item. The tab links to the first sub-page the viewer can see. Set state to hidden to turn off the board and its data publication.", "id": "selection-watch", "label": "Selection Watch", "href": "selection-watch.html", "state": "visible"},
    {"id": "special", "label": "Special Events", "href": "special.html"},
    {"id": "managers", "label": "Managers", "href": "managers.html"},
    {"id": "transactions", "label": "Transactions", "href": "transactions.html"},
    {"id": "records", "label": "Records", "href": "records.html"},
    {"id": "about", "label": "About", "href": "about.html", "icon": "info"},
    {"id": "access", "label": "Accessibility", "href": "access.html", "state": "visible", "icon": "accessibility"},
    {"id": "app", "label": "Notification settings", "href": "app.html", "icon": "bell"}
  ],
  "rows": {
    "poll": {"label": "", "items": [
      {"label": "Latest poll", "href": "poll.html", "match": "^poll(-top25-wk\\d+)?\\.html$"},
      {"label": "How the poll works", "href": "poll-how.html"},
      {"label": "Bot ballots", "href": "poll-bots.html"}
    ]},
    "selection-watch": {"label": "", "items": [
      {"label": "CCG", "href": "ccg-race.html", "state": "visible"},
      {"label": "Playoffs", "href": "selection-watch.html", "state": "hidden-dev"}
    ]},
    "special": {"label": "Event", "items": [
      {"label": "The Guillotine", "href": "special.html", "match": "^(special|guillotine-\\d{4})\\.html$", "icon": "../assets/logos/Guillotine/Guillotine%20G.png"},
      {"label": "Dwight Fight", "href": "dwight-fight.html", "match": "^dwight-fight(-\\d{4})?\\.html$", "icon": "../assets/logos/Dwight%20Fight/Dwight%20Fight%20Glasses.png", "state": "visible"},
      {"label": "Champions League", "href": "cl-standings.html", "match": "^cl-[a-z-]+\\.html$", "state": "hidden-dev"}
    ]},
    "guillotine-seasons": {"label": "Season", "min": 2, "items": [
      {"label": "2026", "href": "special.html", "match": "^special\\.html$"},
      {"label": "2025 replay", "href": "guillotine-2025.html", "state": "hidden-dev"}
    ]},
    "champions-league": {"label": "", "items": [
      {"label": "Standings", "href": "cl-standings.html", "state": "hidden-dev"},
      {"label": "Schedule", "href": "cl-schedule.html", "state": "hidden-dev"},
      {"label": "Scoreboard", "href": "cl-scoreboard.html", "state": "hidden-dev"},
      {"label": "Field", "href": "cl-field.html", "state": "hidden-dev"},
      {"label": "Selection", "href": "cl-selection.html", "state": "hidden-dev"},
      {"label": "Rules", "href": "cl-rules.html", "state": "hidden-dev"}
    ]}
  }
}
